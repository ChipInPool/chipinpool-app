{
  "expo": {
    "name": "ChipInPool",
    "slug": "chipinpool",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#001F3F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chipinpool.mobile",
      "buildNumber": "12",
      "infoPlist": {
        "NSCameraUsageDescription": "ChipIn needs camera access for identity verification and profile photos.",
        "NSPhotoLibraryUsageDescription": "ChipIn needs photo library access to upload profile photos.",
        "NSFaceIDUsageDescription": "ChipIn uses Face ID for secure authentication.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001F3F"
      },
      "package": "com.chipinpool.app",
      "versionCode": 12,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "chipinpool",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/36899060-b8b7-49a1-90d0-fc1b0062c7a7"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7FFFD4"
        }
      ],
      [
        "expo-updates",
        {
          "enabled": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-local-authentication"
    ],
    "owner": "chipinpool",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "https://chipinpool-csekdvghcqepcthm.centralus-01.azurewebsites.net",
      "eas": {
        "projectId": "36899060-b8b7-49a1-90d0-fc1b0062c7a7"
      }
    }
  }
}
