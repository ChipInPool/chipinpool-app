{
  "expo": {
    "name": "ChipIn",
    "slug": "chipinpool",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#001F3F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chipinpool.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ChipIn needs camera access for identity verification and profile photos.",
        "NSPhotoLibraryUsageDescription": "ChipIn needs photo library access to upload profile photos.",
        "NSFaceIDUsageDescription": "ChipIn uses Face ID for secure authentication.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001F3F"
      },
      "package": "com.chipinpool.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "chipinpool",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7FFFD4"
        }
      ],
      "expo-updates"
    ],
    "owner": "donpsqs",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
