# ChipInPool environment variables (copy to .env and fill in)
# Only non-secret placeholders are shown here; never commit real secrets.

# Core
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/chipinpool

# Session — REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Trusted base URL used for links emailed/texted to users (password reset, etc.)
# Falls back to REPLIT_DOMAINS / WEBSITE_HOSTNAME, then a production default.
APP_URL=http://localhost:5000

# Field-level encryption for bank account/routing numbers and Plaid tokens.
# 32 bytes as hex (64 chars) or base64. Generate with: openssl rand -hex 32
# Leave unset to disable at-rest encryption (data stays plaintext, backward
# compatible). After setting it, migrate existing rows before relying on it.
ENCRYPTION_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@chipinpool.com

# Plaid (optional, for ACH)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
